


.claude
# Server (Python)
server/.venv/
server/.env
__pycache__/
*.pyc
server/*.db
server/app/storage/calibration_profiles/*
!server/app/storage/calibration_profiles/.gitkeep

# Tracking worker runtime files
server/app/storage/tracking_worker.pid
server/app/storage/tracking_worker.stop
server/app/storage/tracking_worker.log*
server/app/storage/tracking_worker_state.json
server/app/storage/tracking_worker_state.tmp

# Site
site/.env

.pytest_cache/
server/app/storage/device_settings.json
server/app/storage/recenter.json
server/app/storage/active_user.json
server/app/storage/device_id.txt
server/app/storage/screenshots/

# Gaze benchmark recordings and diagnostics traces (local baselines, never committed)
*.jsonl
server/app/storage/tts_cache/

# IrisClick Desktop: logs, process IDs, link and sync state (local to each PC)
server/app/storage/irisclick_*.log
server/app/storage/irisclick_*.pid
server/app/storage/desktop_session.json
server/app/storage/desktop_sync_state.json
