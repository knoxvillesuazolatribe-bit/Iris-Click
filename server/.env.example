# Copy to server/.env (gitignored) and fill in. Every key is optional; the
# defaults live in app/config.py. Never commit real passwords.

APP_NAME=IrisClick
DEBUG=false
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SITE_URL=http://localhost:5173

# Camera & engine
CAMERA_INDEX=0
CAMERA_RESOLUTION=720p
DEEP_GAZE_ENABLED=true

# Worker behaviour
AUTO_START_WORKER=true
DWELL_CLICK_ENABLED=false
DWELL_MS=700
BLINK_THRESHOLD=0.18
RIGHT_BLINK_ACTION=go_back
SWAP_BLINK_SIDES=false

# Database: Supabase Postgres. Leave DB_HOST empty to use the local SQLite
# file (server/irisclick.db) instead.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Postgres schema for the IrisClick tables (public keeps the legacy tables).
DB_SCHEMA=irisclick

# First administrator, read only by scripts/create_admin.py. Delete
# ADMIN_PASSWORD after running it: the database keeps only its hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=PDAO Administrator

# Emergency SOS email (SMTP). For Gmail: turn on 2-step verification, create an
# App Password (Google Account > Security > App passwords) and paste it below.
# Leave SMTP_HOST empty and SOS alerts show "Failed: email is not set up".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls

# Look at the top or bottom 8% of the screen for DWELL_MS to scroll.
EDGE_SCROLL_ENABLED=true
EDGE_SCROLL_BAND=0.08
