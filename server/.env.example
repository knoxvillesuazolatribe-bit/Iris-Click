# Copy to server/.env (gitignored) and fill in. Every key is optional; the
# defaults live in app/config.py. Never commit real passwords.

APP_NAME=IrisClick
DEBUG=false
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SITE_URL=http://localhost:5173

# Camera & engine
CAMERA_INDEX=0
CAMERA_RESOLUTION=720p
DEEP_GAZE_ENABLED=true

# Worker behaviour
AUTO_START_WORKER=true
DWELL_CLICK_ENABLED=false
DWELL_MS=700
BLINK_THRESHOLD=0.18
RIGHT_BLINK_ACTION=right_click
SWAP_BLINK_SIDES=false

# Database: Supabase Postgres. Leave DB_HOST empty to use the local SQLite
# file (server/irisclick.db) instead.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# Postgres schema for the IrisClick tables (public keeps the legacy tables).
DB_SCHEMA=irisclick

# First administrator, read only by scripts/create_admin.py. Delete
# ADMIN_PASSWORD after running it: the database keeps only its hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=PDAO Administrator

# Emergency SOS email (SMTP). For Gmail: turn on 2-step verification, create an
# App Password (Google Account > Security > App passwords) and paste it below.
# Leave SMTP_HOST empty and SOS alerts show "Failed: email is not set up".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls

# SMS (accounts on this computer: verify the number, Forgot PIN). Empty keys = SMS off.
# iProg SMS (iprogsms.com, no phone needed). Its shared sender reaches Globe/TM/DITO/GOMO;
# Smart/TNT need an approved sender name. Empty SMS_PROVIDER = iprog when the token is set.
SMS_PROVIDER=
IPROG_API_TOKEN=
# Earlier gateway, kept for old setups:
SEMAPHORE_API_KEY=
# Optional approved sender name; empty uses Semaphore's default sender.
SEMAPHORE_SENDER_NAME=
# Testing lock: while set, texts go ONLY to this number. Remove at launch.
SMS_ONLY_TO=

# Look at the top or bottom 8% of the screen for DWELL_MS to scroll.
EDGE_SCROLL_ENABLED=true
EDGE_SCROLL_BAND=0.08

# Accounts and the IrisClick Desktop link (read straight from the environment; set them in
# Vercel for the hosted server).
# legacy (default: admin-created name tiles) or device_accounts (self sign-up, username + PIN).
ASSISTIVE_SIGNIN_MODE=legacy
# on = sign-up asks for a PDAO setup code; empty or off = no setup code.
SETUP_CODES=
# on = only approved computers may sign in; empty or off = any computer.
IRISCLICK_COMPUTER_LOCK=
# IrisClick Desktop only: the hosted website it links to and syncs with.
# Empty = no link (the routes answer 503).
IRISCLICK_CLOUD_URL=
# Hosted server only: at least 32 random characters that sign desktop tokens and SMS tickets.
# Empty = a key derived from DB_PASSWORD (works, but a dedicated secret is better).
IRISCLICK_DESKTOP_SECRET=
